{
  "name": "spada-calendar-extension",
  "version": "1.0.0",
  "description": "Chrome Extension (MV3) to scan all SPADA UPNYK assignments (including ones missing from Moodle .ics) and sync them to Google Calendar",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "promo": "node scripts/generate-promo.mjs",
    "package": "node scripts/package.mjs",
    "package:strict": "node scripts/package.mjs --strict"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
